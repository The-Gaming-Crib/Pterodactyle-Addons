{
  "_comment": "DeskForge",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-11-27T00:00:00+00:00",
  "name": "DeskForge",
  "author": "admin@thegamingcrib.net",
  "description": "Linux desktops over RDP / VNC / SSH (no web access). Pick distro + desktop environment. Container based, native speed, ARM + x86.",
  "features": [],
  "docker_images": {
    "Ubuntu 26.04 - Ubuntu-style (XFCE)": "ghcr.io/the-gaming-crib/deskforge:ubuntu-26-xfce",
    "Ubuntu 24.04 - Ubuntu-style (XFCE)": "ghcr.io/the-gaming-crib/deskforge:ubuntu-24-xfce",
    "Ubuntu 24.04 - GNOME (real Ubuntu desktop, experimental, heavy)": "ghcr.io/the-gaming-crib/deskforge:ubuntu-24-gnome",
    "Ubuntu 22.04 - Ubuntu-style (XFCE)": "ghcr.io/the-gaming-crib/deskforge:ubuntu-22-xfce",
    "Ubuntu 20.04 - Ubuntu-style (XFCE)": "ghcr.io/the-gaming-crib/deskforge:ubuntu-20-xfce",
    "Debian 13 - XFCE": "ghcr.io/the-gaming-crib/deskforge:debian-13-xfce",
    "Debian 12 - XFCE": "ghcr.io/the-gaming-crib/deskforge:debian-12-xfce",
    "Debian 11 - XFCE": "ghcr.io/the-gaming-crib/deskforge:debian-11-xfce",
    "Kali Linux - XFCE": "ghcr.io/the-gaming-crib/deskforge:kali-xfce",
    "Parrot OS - XFCE": "ghcr.io/the-gaming-crib/deskforge:parrot-xfce",
    "Linux Mint 22 - XFCE": "ghcr.io/the-gaming-crib/deskforge:mint-xfce",
    "Devuan Daedalus - XFCE": "ghcr.io/the-gaming-crib/deskforge:devuan-xfce",
    "Fedora 43 - XFCE": "ghcr.io/the-gaming-crib/deskforge:fedora-43-xfce",
    "Fedora 42 - XFCE": "ghcr.io/the-gaming-crib/deskforge:fedora-42-xfce",
    "Fedora 41 - XFCE": "ghcr.io/the-gaming-crib/deskforge:fedora-41-xfce",
    "Rocky Linux 9 - XFCE": "ghcr.io/the-gaming-crib/deskforge:rocky-9-xfce",
    "AlmaLinux 9 - XFCE": "ghcr.io/the-gaming-crib/deskforge:alma-9-xfce",
    "CentOS Stream 9 - XFCE": "ghcr.io/the-gaming-crib/deskforge:centos-9-xfce",
    "Oracle Linux 9 - XFCE": "ghcr.io/the-gaming-crib/deskforge:oracle-9-xfce",
    "Arch Linux (x86) - XFCE": "ghcr.io/the-gaming-crib/deskforge:arch-xfce",
    "Arch Linux ARM - XFCE": "ghcr.io/the-gaming-crib/deskforge:arch-arm-xfce",
    "Manjaro (x86) - XFCE": "ghcr.io/the-gaming-crib/deskforge:manjaro-xfce",
    "CachyOS (x86) - XFCE": "ghcr.io/the-gaming-crib/deskforge:cachyos-xfce",
    "Alpine 3.21 - XFCE": "ghcr.io/the-gaming-crib/deskforge:alpine-321-xfce",
    "Alpine 3.20 - XFCE": "ghcr.io/the-gaming-crib/deskforge:alpine-320-xfce",
    "Alpine Edge - XFCE": "ghcr.io/the-gaming-crib/deskforge:alpine-edge-xfce",
    "openSUSE Tumbleweed - XFCE": "ghcr.io/the-gaming-crib/deskforge:opensuse-tw-xfce",
    "openSUSE Leap 15.6 - XFCE": "ghcr.io/the-gaming-crib/deskforge:opensuse-leap-xfce",
    "Void Linux - XFCE": "ghcr.io/the-gaming-crib/deskforge:void-xfce"
  },
  "file_denylist": [],
  "startup": "bash /opt/start.sh",
  "config": {
    "files": "{}",
    "startup": "{\"done\":\"Desktop ready\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/ash\nmkdir -p /mnt/server\necho ok\nexit 0",
      "container": "alpine:3.20",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Access",
      "description": "Protocols to expose: rdp,vnc,ssh,rdp+vnc,rdp+ssh,vnc+ssh,rdp+vnc+ssh,all. First one uses the server's primary port, the next ones use primary+1, +2 (order rdp, vnc, ssh) - add those allocations.",
      "env_variable": "ACCESS",
      "default_value": "rdp",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|in:rdp,vnc,ssh,rdp+vnc,rdp+ssh,vnc+ssh,rdp+vnc+ssh,all",
      "field_type": "text"
    },
    {
      "name": "Desktop password",
      "description": "Used for RDP and VNC. 6-8 characters (VNC limit).",
      "env_variable": "DESKTOP_PASSWORD",
      "default_value": "changeme",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|between:6,8",
      "field_type": "text"
    },
    {
      "name": "RDP username",
      "description": "Username for RDP login.",
      "env_variable": "RDP_USER",
      "default_value": "desktop",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|alpha_dash|max:20",
      "field_type": "text"
    },
    {
      "name": "SSH public key",
      "description": "Your public key (ssh-ed25519 AAAA...). Needed for ssh; SSH is key-login only.",
      "env_variable": "SSH_PUBKEY",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:600",
      "field_type": "text"
    },
    {
      "name": "Resolution",
      "description": "e.g. 1920x1080",
      "env_variable": "RESOLUTION",
      "default_value": "1600x900",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|regex:/^\\d{3,4}x\\d{3,4}$/",
      "field_type": "text"
    }
  ]
}